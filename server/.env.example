# --- Local development defaults ---
# Uses your local Postgres superuser against a throwaway dev database.
# Fine for a dev machine; do NOT use these on a production install.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=ehajiri_db
PORT=5000
# REQUIRED — the server refuses to start if any of these are missing, too short
# (<24 chars) or a known default. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Must equal LicenseAdmin's SSO_SECRET (signs the "Open Software" links)
SSO_SECRET=
# Must equal LicenseAdmin's LICENSE_SECRET (verifies license keys)
LICENSE_SECRET=
# Shared with LicenseAdmin; authorises its calls to /api/license/distributor|deactivate
INTERNAL_API_KEY=
# Optional: extra browser origins allowed by CORS (comma-separated). Same-origin needs none.
# CORS_ORIGINS=

# --- Production install (packaged app) ---
# The installer (installer/scripts/setup-db.js) creates a dedicated,
# least-privilege "ehajiri" role and database instead of using the local
# postgres superuser — this is intentional, not a mismatch with the dev
# defaults above. Uncomment these ONLY if you are manually replicating what
# the installer does; normally you never edit this by hand in production,
# since obfuscate-build.js generates the real .env during packaging.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ehajiriPlanetInfosys_db
# DB_USER=ehajiri
# DB_PASS=<generated per install — never commit a real password>

# Path to pg_dump.exe, used only by GET /api/backup/sql (native SQL export).
# In the packaged app, electron/main.cjs sets this automatically. In plain
# `npm run dev` (no Electron), it's unset unless you set it here — point it
# at your local PostgreSQL install, e.g.:
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe

# Optional: only the AI Analysis page uses the Anthropic API.
# (The Help widget needs no key; live support chat uses LICENSE_ADMIN_URL +
# INTERNAL_API_KEY + TENANT_ID, which hosted tenants already have.)
# ANTHROPIC_API_KEY=
